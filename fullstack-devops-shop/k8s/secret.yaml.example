# =============================================================================
# TEMPLATE ONLY — do not fill this in and commit it to Git.
#
# Real registry credentials should never live in the repository. Instead,
# create the actual Secret directly in the cluster with kubectl (see README):
#
#   kubectl create secret docker-registry gitlab-registry-secret \
#     --docker-server=$CI_REGISTRY \
#     --docker-username=$CI_REGISTRY_USER \
#     --docker-password=$CI_REGISTRY_PASSWORD \
#     -n devops-shop
#
# This file is kept only to document the Secret's shape for teaching purposes.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: gitlab-registry-secret
  namespace: devops-shop
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "<BASE64_ENCODED_DOCKER_CONFIG_JSON - DO NOT COMMIT REAL VALUE>"
